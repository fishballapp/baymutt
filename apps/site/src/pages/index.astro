---
import shore from '../assets/shore.webp';
import shoreDusk from '../assets/shore-dusk.webp';
import ApprovedScreen from '../components/ApprovedScreen.astro';
import AskAccessScreen from '../components/AskAccessScreen.astro';
import Command from '../components/Command.astro';
import PasteScreen from '../components/PasteScreen.astro';
import Point from '../components/Point.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import copy from '../landing-copy.json';

const REPO = 'https://github.com/fishballapp/baymutt';
const HEADLINE = ['Know why your agent wants it.', 'Hand it over in one paste.'] as const;

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'baymutt',
  applicationCategory: 'DeveloperApplication',
  url: 'https://baymutt.fsh.ba/',
  description: copy.c2,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: copy.c8 },
  publisher: { '@type': 'Organization', name: 'Fishball Ltd', url: 'https://fishball.ltd' },
};
---

<Layout
  title={copy.c1}
  description={copy.c2}
  ogImageAlt={HEADLINE.join(' ')}
  structuredData={softwareApplication}
>
  <SiteHeader />
  <main>
    <section class="l-hero l-wrap" aria-labelledby="hero-title">
      <picture class="l-mutt">
        <source srcset={shoreDusk.src} media="(prefers-color-scheme: dark)" />
        <img src={shore.src} width={shore.width} height={shore.height} alt={copy.c5} />
      </picture>
      <div>
        <h1 id="hero-title">{HEADLINE[0]} <span class="muted">{HEADLINE[1]}</span></h1>
        <p class="l-lede">{copy.c6}</p>
        <a class="btn lg primary" href="/signup">{copy.c7}</a>
        <p class="l-offer">{copy.c8}</p>
      </div>
    </section>

    <section class="l-section l-wrap" aria-label={copy.c9}>
      <Point title={copy.c10} say={copy.c11}><AskAccessScreen /></Point>
      <Point title={copy.c12} say={copy.c13}><PasteScreen /></Point>
      <Point title={copy.c14} say={copy.c15}><ApprovedScreen /></Point>
    </section>

    <section class="l-section l-wrap" aria-labelledby="promises-title">
      <h2 id="promises-title" class="l-h2">{copy.c16}</h2>
      <div class="l-promises">
        <div>
          <h3>{copy.c17}</h3>
          <p>{copy.c18}</p>
          <p><a class="link" href={`${REPO}#how-it-keeps-values-from-the-host`}>{copy.c19}</a></p>
        </div>
        <div>
          <h3>{copy.c20}</h3>
          <p>{copy.c21}</p>
          <p><a class="link" href={REPO}>{copy.c22}</a></p>
        </div>
      </div>
    </section>

    <section class="l-section l-close l-wrap" aria-label={copy.c23}>
      <a class="btn lg primary" href="/signup">{copy.c24}</a>
      <p class="l-offer">{copy.c25}</p>
      <div class="l-start">
        <p>{copy.c26}</p>
        <Command command="npm install -g baymutt" />
        <Command command="baymutt auth login" />
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
