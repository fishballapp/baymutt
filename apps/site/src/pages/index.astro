---
import mark from '@baymutt/web/mark.svg?url';
import shore from '../assets/shore.webp';
import shoreDusk from '../assets/shore-dusk.webp';
import PairingCode from '../components/dashboard/PairingCode.astro';
import PastePage from '../components/dashboard/PastePage.astro';
import Screen from '../components/dashboard/Screen.astro';
import Mark from '../components/Mark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Terminal from '../components/Terminal.astro';
import {
  ACCOUNT,
  ADDRESS,
  LOAD,
  MAC_MINI,
  MACBOOK,
  PAIR,
  PASTE_LINK,
  ROLLBACK,
  SCHEMA_FILE,
  SERVICE_ACCOUNT,
  START,
  WRITE,
} from '../example.ts';
import Layout from '../layouts/Layout.astro';

const DESCRIPTION =
  'baymutt is a secret manager for coding agents. Approve a CLI login once; your agents then load, set and roll back secrets with no prompt, and no command prints a value. Free while in beta.';

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'baymutt',
  applicationCategory: 'DeveloperApplication',
  url: 'https://baymutt.fsh.ba/',
  description: DESCRIPTION,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free in beta' },
  publisher: { '@type': 'Organization', name: 'Fishball Ltd', url: 'https://fishball.ltd' },
};
---

<Layout
  title="baymutt: approve the login once, and your agents handle secrets from there"
  description={DESCRIPTION}
  structuredData={softwareApplication}
>
  <div class="wrap">
    <SiteHeader />
  </div>

  <main>
    <section class="wrap hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title">
          Approve the login once. <span>Your agents handle secrets from there.</span>
        </h1>
        <p class="lede">
          baymutt is a secret manager for coding agents. From the terminal they load, set and roll
          back secrets with no prompt, and <strong>no command prints a value</strong>.
        </p>
        <div class="act">
          <a class="go" href="/signup">Create an account</a>
          <span class="offer">Free while baymutt is in beta.</span>
        </div>
      </div>
      <div class="stage">
        <picture>
          <source srcset={shoreDusk.src} media="(prefers-color-scheme: dark)" />
          <img
            src={shore.src}
            width={shore.width}
            height={shore.height}
            alt="baymutt’s mutt sitting on the shore of a bay, a key hanging from its mouth"
          />
        </picture>
        <Terminal
          class="start"
          label="A terminal: you install baymutt and log in, then an agent runs a command with its secrets"
          lines={START}
        />
      </div>
    </section>

    <section class="sec" aria-labelledby="once-title">
      <div class="wrap">
        <div class="head">
          <div>
            <h2 id="once-title">The one decision is yours.</h2>
            <p class="say">
              <code>baymutt login</code> prints a link. Open it, check the code matches the
              terminal’s, and approve. That CLI login then reads and writes every environment of
              your orgs, until you revoke it.
            </p>
          </div>
          <ul class="nots" aria-label="After approval">
            <li>No prompt when an agent reads or writes a secret.</li>
            <li>No key pasted into a chat.</li>
          </ul>
        </div>
        <div class="two">
          <Terminal
            label="The terminal that logs in"
            title={MAC_MINI.name}
            aside="example account"
            lines={PAIR}
          />
          <Screen path="/pair" label="A drawing of the approval page in your browser">
            <PairingCode account={ACCOUNT.name} code={MAC_MINI.code} />
          </Screen>
        </div>
      </div>
    </section>

    <section class="sec bay" aria-labelledby="then-title">
      <div class="wrap">
        <h2 id="then-title">Then your agents get on with it.</h2>
        <p class="say">None of this needs your approval.</p>

        <ol class="rows">
          <li class="row">
            <div>
              <h3>Load values into any command</h3>
              <p>
                Three lines in <code>.env.schema</code> name the environment. <code>varlock run</code>{' '}
                loads it into the process.
              </p>
            </div>
            <div class="stack">
              <figure class="file" aria-label="An .env.schema file">
                <figcaption>.env.schema</figcaption>
                <pre>{SCHEMA_FILE.map(line => (
                  <span class:list={['line', { comment: line.startsWith('#') }]}>{line}</span>
                ))}</pre>
              </figure>
              <Terminal label="A terminal" lines={LOAD} />
            </div>
          </li>

          <li class="row">
            <div>
              <h3>Undo a bad write</h3>
              <p>Every write is a new version. A deleted secret waits in the bin for 30 days.</p>
            </div>
            <Terminal label="A terminal" lines={ROLLBACK} />
          </li>

          <li class="row wide">
            <div>
              <h3>Ask you for what only you can fetch</h3>
              <p>
                The agent makes a paste link for one name. You paste the value, on your phone if
                that is where you are, and your browser seals it before it is sent.
              </p>
            </div>
            <div class="two">
              <Terminal label="A terminal" lines={PASTE_LINK} />
              <Screen path="/paste" label="A drawing of the paste page in your browser">
                <PastePage
                  name="RESEND_API_KEY"
                  serviceAccount={MACBOOK.name}
                  environment={ADDRESS}
                  reason="to send sign-in emails"
                  where="Resend dashboard, API Keys"
                />
              </Screen>
            </div>
          </li>

          <li class="row">
            <div>
              <h3>Hand CI a narrower key</h3>
              <p>
                A CLI login makes a service account that holds only the environments it names, and
                cannot widen its own access. Its key goes to the command after <code>--</code>,
                never to the screen.
              </p>
            </div>
            <Terminal label="A terminal" lines={SERVICE_ACCOUNT} />
          </li>
        </ol>
      </div>
    </section>

    <section class="sec keysec" aria-labelledby="key-title">
      <div class="wrap two">
        <img class="portrait" src={mark} width="384" height="384" alt="The mutt, a key hanging from its mouth" />
        <div>
          <h2 id="key-title">Agents carry the key. No command prints a value.</h2>
          <p class="say">
            Each CLI login’s key is made on its own computer and never sent. A confirmation is a
            name, a version and a length, so a value never lands in an agent’s context. A failure is
            one JSON line that says what to do next.
          </p>
          <Terminal class="confirm" label="A terminal" lines={WRITE} />
        </div>
      </div>
    </section>

    <section class="sec limits" aria-labelledby="read-title">
      <div class="wrap">
        <h2 id="read-title">Sealed on your side. Unreadable on ours.</h2>
        <p class="say">
          Values are sealed on your computer or in your browser, to keys baymutt never holds, so
          baymutt cannot read them. <strong>It still sees names, sizes, times and who did what.</strong>
        </p>
        <details>
          <summary>What baymutt can and cannot do</summary>
          <div class="ledger">
            <div>
              <h3>baymutt cannot</h3>
              <ul>
                <li>Read a value, in any version.</li>
                <li>
                  Read an environment’s, your account’s or a service account’s private key, or your
                  recovery key.
                </li>
                <li>Let a service account read an environment it was not handed.</li>
                <li>Move a value to another name, version or environment.</li>
              </ul>
            </div>
            <div>
              <h3>baymutt can still</h3>
              <ul>
                <li>See org, environment and secret names, sizes, versions, times, and who did what.</li>
                <li>Withhold anything, or answer with an older version.</li>
                <li>Put a value of its own in a slot: a sealed box does not say who sealed it.</li>
                <li>
                  Serve a dashboard or paste page that leaks what is typed into it. The CLI and the
                  varlock plugin run code baymutt does not serve.
                </li>
              </ul>
            </div>
          </div>
          <ul class="fine">
            <li>
              Revoking a CLI login or service account stops its next load. What it already read stays
              read.
            </li>
            <li>If baymutt is unreachable, loads stop, on your computer and in CI.</li>
            <li>
              Values are sealed with X25519 and AES-256-GCM, through WebCrypto. A passkey or a
              password opens your vault in the browser; an email link signs you in and never opens it.
            </li>
          </ul>
        </details>
      </div>
    </section>

    <section class="close" aria-label="Create an account">
      <div class="wrap">
        <Mark size={80} class="close-mark" />
        <div class="act">
          <a class="go" href="/signup">Create an account</a>
          <span class="offer">Free while baymutt is in beta.</span>
        </div>
      </div>
    </section>
  </main>

  <div class="wrap">
    <SiteFooter />
  </div>
</Layout>

<style>
  .wrap {
    --gutter: clamp(1.25rem, 4vw, 3rem);
    width: 100%;
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol,
  figure {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
    list-style: none;
  }

  h1,
  h2,
  h3 {
    font-weight: 650;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  p code,
  li code {
    font-size: 0.9em;
  }

  main a:not(.go) {
    color: inherit;
  }

  /* The page's one action. */
  .go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    border-radius: var(--radius-control);
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }

  .go:hover {
    background: color-mix(in oklch, var(--accent) 88%, var(--foreground));
  }

  .offer {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  /* The first screen: the headline and the action, beside the mutt on its shore. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    min-height: min(calc(100svh - 4.75rem), 52rem);
    padding-block: 1rem 4rem;
  }

  h1 {
    font-size: clamp(2.375rem, 1.1rem + 3.7vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
  }

  h1 span {
    display: block;
    color: var(--muted);
  }

  .lede {
    max-width: 31rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .lede strong,
  .say strong {
    color: var(--foreground);
    font-weight: 500;
  }

  .stage {
    position: relative;
    padding-bottom: 3.5rem;
  }

  .stage img {
    display: block;
    width: min(100%, 33rem);
    height: auto;
    margin-left: auto;
  }

  /* The one shadow on the page: the terminal lies over the sand. */
  .stage :global(.start) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: min(23rem, 70%);
    box-shadow: 0 18px 40px -18px oklch(0.2 0.03 230 / 0.45);
  }

  /* Sections */
  .sec {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  h2 {
    font-size: clamp(2rem, 1.1rem + 2.6vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.032em;
  }

  .say {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1.1875rem;
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .nots {
    border-top: 2px solid var(--foreground);
  }

  .nots li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* The bay: where the agents work. */
  .bay {
    background: var(--bay);
    color: var(--fog);
  }

  .bay h2,
  .bay h3 {
    color: var(--fog);
  }

  .bay .say,
  .row > div > p {
    color: var(--fog-dim);
  }

  .bay :focus-visible {
    outline-color: var(--bay-accent);
  }

  .rows {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 2px solid var(--fog-dim);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--bay-line);
  }

  .row h3 {
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .row > div > p {
    max-width: 26rem;
    margin-top: 0.625rem;
  }

  .row > div > p code {
    color: var(--fog);
  }

  .row.wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .row.wide > div > p {
    max-width: 40rem;
  }

  .stack {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .file {
    overflow: hidden;
    border: 1px solid var(--bay-line);
    border-radius: 12px;
    background: var(--bay-terminal);
    color: var(--fog);
  }

  .file figcaption {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--bay-line);
    color: var(--fog-dim);
    font-size: 0.75rem;
  }

  .file pre {
    margin: 0;
    padding: 0.875rem 1.125rem 1.125rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .file .line {
    display: block;
  }

  .file .comment {
    color: var(--fog-dim);
  }

  /* The key */
  .keysec .two {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .portrait {
    display: block;
    justify-self: center;
    width: min(24rem, 100%);
    height: auto;
  }

  .keysec :global(.confirm) {
    margin-top: 2rem;
  }

  /* The limits */
  .limits {
    border-top: 1px solid var(--line);
  }

  details {
    max-width: 52rem;
    margin-top: 2rem;
    border-top: 2px solid var(--foreground);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "Show";
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  details[open] summary::after {
    content: "Hide";
  }

  .ledger {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
    padding-top: 1.5rem;
  }

  .ledger h3 {
    padding-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .ledger li {
    padding-block: 0.625rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .fine {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* The close: the same action, nothing else to read. */
  .close {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .close :global(.close-mark) {
    margin: 0 auto 1.75rem;
  }

  .close .act {
    flex-direction: column;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 0;
  }

  @media (width < 60rem) {
    .hero,
    .two,
    .head,
    .keysec .two,
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero {
      min-height: 0;
      padding-block: 1.25rem 4rem;
    }

    .stage img {
      margin-inline: auto;
    }

    .stage :global(.start) {
      left: 50%;
      width: min(23rem, 92%);
      transform: translateX(-50%);
    }

    .portrait {
      width: min(16rem, 70%);
    }
  }

  @media (width < 40rem) {
    .ledger {
      grid-template-columns: 1fr;
    }

    .ledger div + div {
      margin-top: 1.5rem;
    }

    .hero .go {
      width: 100%;
    }
  }
</style>
