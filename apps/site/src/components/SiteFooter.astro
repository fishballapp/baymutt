---
import Mark from './Mark.astro';
---

<footer class="foot">
  <p>
    <Mark size={24} />
    <span>
      baymutt is made by <a href="https://fishball.ltd">Fishball Ltd</a>. The name is <span
        class="name"
        lang="yue-Hant">秘密</span
      >, <i>bei mat</i>: Cantonese for secret.
    </span>
  </p>
  <nav aria-label="More">
    <a href="https://github.com/fishballapp/baymutt">Source</a>
    <a href="/signin">Sign in</a>
  </nav>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  p {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Two characters of one word: never split across lines. */
  .name {
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
