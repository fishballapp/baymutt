---
// Which service account can reach which environment in the example account, and who filled each cell.
// A CLI login holds every environment, as the owner does; a service account a login made holds what
// its maker handed it, and the empty cell is one it cannot fill itself.
import { MAC_MINI, MACBOOK } from '../example.ts';

type Cell = { kind: 'grant'; grant: string; by: string } | { kind: 'none' };

const ENVIRONMENTS = ['acme/app/dev', 'acme/app/production'] as const;

const EVERY = { kind: 'grant', grant: 'read + write', by: 'every environment' } as const;

const ROWS: readonly { serviceAccount: string; origin: string; cells: readonly [Cell, Cell] }[] = [
  { serviceAccount: MACBOOK.name, origin: 'CLI login you approved', cells: [EVERY, EVERY] },
  { serviceAccount: MAC_MINI.name, origin: 'CLI login you approved', cells: [EVERY, EVERY] },
  {
    serviceAccount: 'CI deploy',
    origin: `made by ${MACBOOK.name}`,
    cells: [{ kind: 'none' }, { kind: 'grant', grant: 'read', by: `handed on by ${MACBOOK.name}` }],
  },
];
---

<figure class="board">
  <div class="sheet">
    <table>
      <caption>
        <span class="caption-row">
          <span class="title">Who can reach what</span>
          <span class="example">An example account</span>
        </span>
      </caption>
      <thead>
        <tr>
          <th scope="col">Service account</th>
          {ENVIRONMENTS.map(environment => <th scope="col"><code>{environment}</code></th>)}
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map(({ serviceAccount, origin, cells }) => (
            <tr>
              <th scope="row">
                <span class="service-account">{serviceAccount}</span>
                <span class="sub">{origin}</span>
              </th>
              {cells.map(cell =>
                cell.kind === 'none' ? (
                  <td class="none">
                    <span aria-hidden="true">–</span>
                    <span class="sr-only">no access</span>
                    <span class="sub">cannot give itself any</span>
                  </td>
                ) : (
                  <td>
                    <span class="grant">{cell.grant}</span>
                    <span class="sub">{cell.by}</span>
                  </td>
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption>
    A login you approve reads and writes every environment, as you can, and so do the agents that use
    it. MacBook made CI deploy and handed it one read: that is all it can reach,
    and it cannot widen it.
  </figcaption>
</figure>

<style>
  .board {
    margin: 0;
    display: grid;
    container-type: inline-size;
  }

  .sheet {
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .caption-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .title {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .example {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  th,
  td {
    padding: 0.875rem 1.25rem;
    text-align: left;
    vertical-align: top;
  }

  thead th {
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  thead th code {
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
  }

  tbody tr + tr {
    border-top: 1px solid var(--line);
  }

  tbody th,
  tbody td {
    width: calc(100% / 3);
    font-weight: 400;
  }

  td + td,
  th + td {
    border-left: 1px solid var(--line);
  }

  .service-account,
  .grant {
    display: block;
    font-weight: 500;
  }

  tbody th .service-account {
    font-weight: 650;
  }

  .sub {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .none {
    color: var(--muted);
  }

  figcaption {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (width < 40rem) {
    th,
    td {
      padding: 0.75rem 0.625rem;
    }

    caption {
      padding: 0.875rem 0.75rem;
    }

    thead th code {
      font-size: 0.75rem;
    }

    .sub {
      font-size: 0.75rem;
    }
  }
</style>
