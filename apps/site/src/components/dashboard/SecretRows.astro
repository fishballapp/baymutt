---
type Props = {
  secrets: readonly { name: string; size: string; version: number; by: string; isWritten?: boolean }[];
};
const { secrets } = Astro.props;
---

<ul class="rows">
  {
    secrets.map(({ name, size, version, by, isWritten }) => (
      <li class:list={['row', { written: isWritten }]}>
        <div>
          <code class="name">{name}</code>
          <p class="meta">
            sealed · {size} · v{version} · {by}
          </p>
        </div>
        <div class="actions" aria-hidden="true">
          <span class="btn">Replace</span>
          <span class="btn">History</span>
          <span class="btn danger">Delete</span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    overflow: hidden;
    container-type: inline-size;
  }

  .row {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  /* A row that was just written, as the dashboard leaves it after its one flash. */
  .written {
    background: var(--accent-soft);
  }

  .name {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .meta {
    margin: 0.125rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    gap: 0.375rem;
  }

  @container (width < 34rem) {
    .actions {
      display: none;
    }
  }
</style>
