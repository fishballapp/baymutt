---
type Props = { serviceAccount: string; wants: string; project: string; reason: string };
const { serviceAccount, wants, project, reason } = Astro.props;
---

<div class="decision">
  <div class="sentence">
    <p>
      <strong>{serviceAccount}</strong> asks to <strong>{wants}</strong> <code>{project}</code>
    </p>
    <p class="reason">{reason}</p>
    <p class="note">
      Approving wraps the project key to this service account. What it reads afterwards cannot be unread.
    </p>
  </div>
  <div class="actions" aria-hidden="true">
    <span class="btn">Approve {wants}</span>
    <span class="btn">Deny</span>
  </div>
</div>

<style>
  .decision {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .sentence {
    flex: 1 1 18rem;
    min-width: 0;
  }

  p {
    margin: 0;
  }

  strong {
    font-weight: 500;
  }

  code {
    font-size: 0.8125rem;
  }

  .reason {
    margin: 0.375rem 0;
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .note {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }
</style>
