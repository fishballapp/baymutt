---
// The approval page (apps/web/src/pages/pair.tsx), abridged to what a visitor needs to see.
type Props = { account: string; code: string };
const { account, code } = Astro.props;
---

<div class="pair">
  <div>
    <p class="title">Approve this login?</p>
    <p class="lede">A terminal ran <code>baymutt login</code> and asks to join {account}.</p>
  </div>
  <div class="code-panel">
    <code class="code"><mark class="match">{code}</mark></code>
    <p>This must match the code in the terminal.</p>
  </div>
  <p>
    Approving lets it <strong>read and write every environment of your orgs</strong>, now and later.
    What it reads stays read, even after you revoke it.
  </p>
  <div class="actions" aria-hidden="true">
    <span class="btn primary">The codes match: approve it</span>
    <span class="btn">Do not approve</span>
  </div>
</div>

<style>
  .pair {
    display: grid;
    gap: 0.875rem;
  }

  p {
    margin: 0;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .lede {
    color: var(--muted);
  }

  strong {
    font-weight: 650;
  }

  .code-panel {
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
  }

  .code-panel p {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .code {
    display: block;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
