---
type Props = { name: string; serviceAccount: string; environment: string; reason: string; where: string };
const { name, serviceAccount, environment, reason, where } = Astro.props;
---

<div class="paste">
  <p class="title">Paste <code>{name}</code></p>
  <p class="lede"><strong>{serviceAccount}</strong> asks for it in <code>{environment}</code>.</p>
  <dl>
    <div><dt>Why</dt><dd>{reason}</dd></div>
    <div><dt>Where to find it</dt><dd>{where}</dd></div>
  </dl>
  <p class="label">Value</p>
  <div class="field" aria-hidden="true"></div>
  <p class="note">
    Sealed in this browser to the environment’s key before it is sent. baymutt cannot read it, and this
    page will not show it again.
  </p>
  <div class="actions" aria-hidden="true">
    <span class="btn primary">Seal and save</span>
  </div>
</div>

<style>
  p {
    margin: 0;
  }

  .title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .title code {
    font-size: 1.125rem;
  }

  .lede {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .lede strong {
    color: var(--foreground);
    font-weight: 500;
  }

  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0.875rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--surface);
  }

  dt {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  dd {
    margin: 0;
  }

  .label {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .field {
    height: 3.5rem;
    margin-top: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
  }

  .note {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .actions {
    margin-top: 0.875rem;
  }
</style>
