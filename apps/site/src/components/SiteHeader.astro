---
import Mark from './Mark.astro';
---

<header class="top">
  <a class="brand" href="/" aria-label="baymutt, home">
    <Mark size={36} />
    <span aria-hidden="true">baymutt</span>
  </a>
  <nav aria-label="Site">
    <a class="source" href="https://github.com/fishballapp/baymutt">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      <span class="label">GitHub</span>
    </a>
    <a href="/signin">Sign in</a>
  </nav>
</header>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    color: var(--foreground);
    font-size: 1.1875rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--radius-control);
    color: var(--foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }

  nav a:hover {
    background: var(--sunken);
  }

  .source {
    color: var(--muted);
  }

  svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* At phone width the icon says it, and the link keeps its name for a screen reader. */
  @media (width < 40rem) {
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
