---
// baymutt's mark: the mutt in a round window of the bay, a key hanging from its mouth. One drawing
// at every size, from the favicon up.
import mark from '@baymutt/web/mark.svg?url';

type Props = { size: number; class?: string };
const { size, class: className } = Astro.props;
---

<img class:list={['mark', className]} src={mark} width={size} height={size} alt="" />

<style>
  .mark {
    display: block;
    flex: none;
  }
</style>
