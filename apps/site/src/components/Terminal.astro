---
// What the CLI prints, on the bay's ink. Every command is an agent's, named in the gutter; a note in
// the mutt's tan is what the owner does off screen, which the CLI does not print.
import { jsonLines } from '../json.ts';
import type { TerminalLine } from '../terminal.ts';

type Props = {
  /** What the terminal shows, for a reader that cannot see it. */
  label: string;
  lines: readonly TerminalLine[];
};

const { label, lines } = Astro.props;

/** How many spaces a printed line starts with: where its wrapped continuation lines up. */
const indentOf = (tokens: readonly { text: string }[]) => /^ */.exec(tokens[0]?.text ?? '')?.[0].length ?? 0;

---

<figure class="terminal" aria-label={label}>
  <div class="body">
    {
      lines.map(line => {
        if (line.kind === 'command') {
          return (
            <div class="line command">
              <span class="who">agent</span>
              <code class="text">{line.text}</code>
            </div>
          );
        }
        if (line.kind === 'note') {
          return (
            <div class="line note">
              <span class="who" />
              <span class="text">{line.text}</span>
            </div>
          );
        }
        if (line.kind === 'stderr') {
          return (
            <div class="line stderr">
              <span class="who" />
              <code class="text">{line.text}</code>
            </div>
          );
        }
        return (
          <div class="line">
            <span class="who" />
            <code class="text">
              {jsonLines(line.value, line.only).map(tokens => (
                <span class="json" style={`--indent: ${indentOf(tokens)}`}>
                  {tokens.map(token => (
                    <span class={token.kind}>{token.text}</span>
                  ))}
                </span>
              ))}
            </code>
          </div>
        );
      })
    }
  </div>
</figure>

<style>
  .terminal {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--bay-line);
    border-radius: 12px;
    background: var(--bay-terminal);
    color: var(--fog);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .body {
    padding: 0.875rem 1.125rem 1.125rem 0;
  }

  .line {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .who {
    padding-right: 0.75rem;
    color: var(--fog-dim);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    line-height: 1.9;
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }

  .text {
    font-size: inherit;
  }

  /* A wrapped line continues under its own text, never left of it: past a JSON line's indent and
     the width of its key's quote, past a command's "$ ". */
  .json {
    display: block;
    padding-left: calc((var(--indent) + 2) * 1ch);
    text-indent: calc((var(--indent) + 2) * -1ch);
  }

  .command .text {
    padding-left: 2ch;
    text-indent: -2ch;
  }

  .command + .line:not(.command),
  .line:not(.command) + .command {
    margin-top: 0.25rem;
  }

  .command .text::before {
    content: "$ ";
    color: var(--bay-accent);
    user-select: none;
  }

  .stderr .text,
  .key {
    color: var(--fog-dim);
  }

  .string,
  .number,
  .literal {
    color: var(--bay-accent);
  }

  .note {
    margin-block: 0.625rem;
  }

  .note .text {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--mutt);
    font-family: var(--font-sans);
  }

  .note .text::before,
  .note .text::after {
    content: "";
    flex: 1;
    border-top: 1px dashed var(--bay-line);
  }

  .note .text::before {
    flex: 0 0 0.75rem;
  }

  ::selection {
    background: var(--bay-line);
    color: var(--fog);
  }

  @media (width < 40rem) {
    .line {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    .who {
      padding-right: 0.5rem;
      letter-spacing: 0.02em;
    }

    .body {
      padding-right: 0.875rem;
    }
  }
</style>
