# baymutt's Worker — environment schema (varlock + baymutt itself).
#
# Safe to commit: it names the baymutt project the values are in, never the values. Read by the
# deploy (scripts/deploy-worker.ts) and the remote migration; local `wrangler dev` needs none of it.
# Locally the machine key comes from where `baymutt pair` put it; in CI it is BAYMUTT_KEY.
# The plugin is named by path: as a dependency it would close a cycle (it bundles the CLI, whose
# tests run this Worker). Build it first: `pnpm -F @baymutt/varlock-plugin build`.
#
# @defaultRequired=true
# @defaultSensitive=true
# @plugin(../../packages/varlock-plugin/)
# @initBaymutt(key=$BAYMUTT_KEY)
# @setValuesBulk(baymuttLoad("baymutt/worker-web/production"))
# ---

# The machine key of the CI job (a machine that reads this one project). Unset on a paired machine.
# @required=false
BAYMUTT_KEY=

# Cloudflare deploy token baymutt-deploy (Workers Scripts, D1, Account Settings: Read; routes and
# certificates on the fsh.ba zone). Not a Worker runtime secret: absent from scripts/secret-keys.json.
CLOUDFLARE_DEPLOY_TOKEN=

# --- Worker runtime secrets (uploaded by scripts/deploy-worker.ts; must match scripts/secret-keys.json) ---

# Signs Better Auth's session cookies. Replacing it signs everyone out.
BETTER_AUTH_SECRET=

# The password of the forwardemail alias sign-in links are sent as (MAIL_SENDER in wrangler.jsonc).
FORWARD_EMAIL_ALIAS_PASSWORD=
